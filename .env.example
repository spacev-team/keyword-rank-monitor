# ── 자사 판별(기본값 있음 — 바꿀 때만 설정) ─────────────
# KRM_SELF_DOMAINS=33m2.co.kr
# KRM_PLAY_PKG=com.samsamm2.mobileapp
# KRM_IOS_ID=1491007143

# ── 저장/알림(선택) ─────────────────────────────────────
# Google Sheets 미러 — 미설정 시 SQLite 만 사용
# KRM_SHEET_ID=
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json
# Google Chat 런 요약·변화 알림 — 미설정 시 생략
# KRM_GOOGLE_CHAT_WEBHOOK_URL=

# ── 구글 수집(선택) ─────────────────────────────────────
# SerpAPI 키 설정 시 구글이 스크레이핑 대신 API 경유(차단 회피, 유료)
# SERPAPI_KEY=
# 네이버 검색량(키워드도구) — EMM 과 동일 형식. 설정 시 daily 런이 240개 키워드의
# 최근 30일 검색수를 수집해 대시보드 '검색량/일' 컬럼에 표시 (Actions 는 KRM_SEARCHAD 시크릿)
# NAVER_SEARCHAD_ACCOUNTS=CID:APIKEY:SECRET

# ── 튜닝(선택) ──────────────────────────────────────────
# KRM_ORGANIC_LIMIT=20
# KRM_SLEEP_BASE=2.0
# KRM_GOOGLE_SLEEP=6.0
